# Neon pooled PostgreSQL connection string (host contains -pooler). The app uses it at runtime through the adapter.
DATABASE_URL=""

# Neon direct PostgreSQL connection string. Used only by the Prisma CLI and migrations.
DIRECT_URL=""

# Signs the httpOnly session cookies for members and admins. At least 32 random characters.
SESSION_SECRET=""

# Key for sending the two account emails through Resend.
RESEND_API_KEY=""

# Sender address for the two account emails. Needs the verified domain from D24.
EMAIL_FROM=""

# Public address of the app, used to build the links in the two account emails.
APP_URL=""
